{
  "name": "fieldbase-crm",
  "private": true,
  "version": "0.0.0",
  "description": "FieldBase — AI-native CRM for service SMBs. MCP server as the hero feature.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @fieldbase/web",
    "dev:mcp": "npm run dev --workspace @fieldbase/mcp-server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
