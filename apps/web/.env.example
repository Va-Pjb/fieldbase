# Supabase — copy this file to `.env.local` and fill in values from your project
# (Supabase dashboard → Project Settings → API). Both values are public and
# safe to ship in the browser bundle; RLS enforces per-user access.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public client key: the modern "publishable" key (sb_publishable_...) or the
# legacy anon JWT.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
